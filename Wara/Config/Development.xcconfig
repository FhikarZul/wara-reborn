// Define scheme & host
API_SCHEME = https
API_HOST = api-dev.wara.web.id

// (Optional) Keep API_BASE_URL if needed elsewhere
SLASH = /
API_BASE_URL = $(API_SCHEME):$(SLASH)/$(API_HOST)
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_OPTIMIZATION_LEVEL[sdk=iphonesimulator*] = -Onone
SWIFT_COMPILATION_MODE[sdk=iphonesimulator*] = singlefile